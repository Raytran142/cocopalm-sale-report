  "params": [
    "booking_total",
    "room_total",
    "room_night",
    "adr"
  ],
  "defaultParam": "booking_total",
  "donutMetric": "booking_total",
  "matrixMetrics": [
    "booking_total",
    "room_total",
    "room_night",
    "booking_count",
    "adr"
  ],
  "tableMetrics": [
    "booking_total",
    "room_total",
    "room_night",
    "booking_count",
    "adr"
