      "label": "Room night",
      "col": "room_night",
      "format": "int",
      "better": "higher",
      "icon": "clock"
    },
    {
      "key": "booking_count",
      "label": "Số booking",
      "col": "booking_count",
      "format": "int",
      "better": "higher",
      "icon": "circle-check"
    },
    {
      "key": "adr",
      "label": "Giá phòng TB / đêm (ADR)",
