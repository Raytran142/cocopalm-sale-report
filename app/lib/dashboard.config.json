    "secondaryIcon": "layout-dashboard"
  },
  "thresholds": [
    {
      "key": "adr_target",
      "label": "ADR mục tiêu",
      "kind": "target",
      "metric": "adr",
      "op": ">=",
      "value": 970000,
      "rule": "p75",
      "basis": "phân vị 75 theo từng dòng = 966.144, làm tròn lên"
    }
  ],
  "alerts": {
    "dim": "room_type_name"
  },
  "defaultDays": 30,
  "export": {
    "separator": ";",
    "filename": "cocopalm-sale-dashboard"
  }
